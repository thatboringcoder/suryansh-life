---
import '../styles/life.css';
const { title = 'Suryansh — a life in progress', description = 'A little world of thoughts, things I make, and the places that made me.', home = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#171a19"/><link rel="canonical" href={new URL(path,'https://suryansh.life')}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title}</title><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/></head><body class:list={[{ 'is-home': home }]}><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="wordmark" href="/" aria-label="Suryansh home">suryansh<span class="little-star">✳</span></a><nav aria-label="Main navigation"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a><a href="/blog/" aria-current={path.startsWith('/blog')?'page':undefined}>Blog</a><a href="/projects/" aria-current={path.startsWith('/projects')?'page':undefined}>Work</a></nav><a class="say-hello" href="https://github.com/thatboringcoder">Say hello <span>↗</span></a></header><main id="main"><slot/></main>{!home && <footer class="site-footer"><span>A small corner of the internet. Made slowly.</span><a href="https://github.com/thatboringcoder">GitHub ↗</a><a href="/rss.xml">RSS ↗</a><span>suryansh.life</span></footer>}</body></html>
