---
import LifeLayout from '../../layouts/LifeLayout.astro';
import Sketch from '../../components/life/Sketch.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<LifeLayout title="Thoughts — Suryansh"><div class="room"><section class="room-intro"><div><div class="eyebrow">The quieter side</div><h1>Headphones on.<br/><em>Thoughts out.</em></h1><p>Notes from somewhere between figuring things out and just letting them be. Pull up a chair.</p></div></section><div class="section-label"><span>Notes & little observations</span><span>{String(posts.length).padStart(2,'0')} {posts.length===1?'entry':'entries'}</span></div>{posts.map(p=><a class="entry" href={`/blog/${p.id}/`}><time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</time><div><h2>{p.data.title}</h2><p>{p.data.description}</p><div class="tags">{p.data.tags.map(t=>`#${t}`).join('　')}</div></div><span class="entry-arrow">↗</span></a>)}<a class="quiet-link" href="/rss.xml">Follow the journal via RSS ↗</a><aside class="corner-sketch"><Sketch mode="listening"/></aside></div></LifeLayout>
