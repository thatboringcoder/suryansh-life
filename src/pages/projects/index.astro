---
import LifeLayout from '../../layouts/LifeLayout.astro';
import Sketch from '../../components/life/Sketch.astro';
import { getCollection } from 'astro:content';
const projects=(await getCollection('projects')).filter(p=>p.id!=='minrock').sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<LifeLayout title="Work — Suryansh"><div class="room"><section class="room-intro"><div><div class="eyebrow">At the workbench</div><h1>Small ideas.<br/><em>Open endings.</em></h1><p>Things I'm making, things I'm learning, and experiments that might become something.</p></div></section><div class="section-label"><span>Projects & experiments</span><span>Always in progress</span></div>{projects.map(p=><a class="entry" href={`/projects/${p.id}/`}><span class="entry-type">{p.data.category}</span><div><h2>{p.data.title}</h2><p>{p.data.description}</p><div class="tags">{p.data.tags.join('　/　')}</div></div><span class="entry-arrow">↗</span></a>)}<a class="quiet-link" href="https://github.com/thatboringcoder">More on GitHub ↗</a><aside class="corner-sketch"><Sketch/></aside></div></LifeLayout>
