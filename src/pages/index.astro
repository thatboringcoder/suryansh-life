---
import LifeLayout from '../layouts/LifeLayout.astro';
const schools=['Chiranjeeve','Oxford','Sarala Birla','KIIT'];
---
<LifeLayout home title="Suryansh — after the lights go out">
  <section class="journey" aria-label="A night walk through the places that made me">
    <div id="night-game" class="scene" aria-hidden="true"></div>
    <div class="night-vignette" aria-hidden="true"></div>
    <div class="intro">
      <div class="eyebrow">A life, remembered after dark</div>
      <h1>Some places<br/>never <em>leave you.</em></h1>
      <p>I'm Suryansh. Walk with me through the quiet.<br/>The places that made me are still here.<br/>You just have to get a little closer.</p>
      <button id="begin" class="begin" disabled>Enter the night <span>→</span></button>
      <span class="begin-note">Headphones recommended · sound is optional</span>
    </div>
    <div class="chapter-caption" aria-live="polite" aria-atomic="true">
      <small id="chapter-number"></small><h2 id="chapter-name"></h2><p id="chapter-description"></p>
    </div>
    <div class="end-note">There is more beyond the trees.<br/><a href="/blog/">Read the journal ↗</a><a href="/projects/">Visit the workroom ↗</a></div>
    <div class="journey-bottom">
      <div class="scroll-note">HOLD ← → OR A / D TO WALK<small>Scroll to wander · Esc or tap the scene to stop</small></div>
      <nav class="chapter-nav" aria-label="Walk to a memory">{schools.map((s,i)=><button data-chapter={i} aria-pressed="false"><b>0{i+1}</b><span>{s}</span></button>)}</nav>
      <div class="walk-controls" aria-label="Walking controls"><button data-walk="-1" aria-label="Hold to walk left">←</button><button data-walk="1" aria-label="Hold to walk right">→</button></div>
    </div>
    <p id="game-status" class="game-status" role="status">Finding the path…</p>
  </section>
  <noscript><div class="room"><h1>The places that made me</h1><p>Chiranjeeve School → Oxford Public School → Sarala Birla Public School → KIIT.</p><a href="/blog/">Read the journal →</a></div></noscript>
</LifeLayout>
<script src="../scripts/journey.ts"></script>
